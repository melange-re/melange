A record field renamed to __proto__ must be an own data property.
Integer and object payloads must survive construction, updates, copies and cycles.

  $ . ./setup.sh
  $ cat > run.ml <<'ML'
  > type 'a record = { p : 'a [@mel.as "__proto__"]; other : int }
  > let make p = { p; other = 1 }
  > let constant = { p = 5; other = 1 }
  > let update r p = { r with p }
  > let preserve r = { r with other = 2 }
  > let duplicate r = Obj.dup r
  > type 'a node = { p : 'a [@mel.as "__proto__"]; next : 'a node }
  > let cycle p = let rec n = { p; next = n } in n
  > let[@inline never] id x = x
  > let backpatched p = let rec n = { p = id p; next = n } in n
  > ML
  $ melc -ppx melppx -o run.js run.ml
  $ cat run.js
  // Generated by Melange
  'use strict';
  
  const Caml_obj = require("melange.js/caml_obj.js");
  
  function make(p) {
    return {
      __proto__: p,
      other: 1
    };
  }
  
  function update(r, p) {
    return {
      __proto__: p,
      other: r.other
    };
  }
  
  function preserve(r) {
    return {
      __proto__: r.__proto__,
      other: 2
    };
  }
  
  const duplicate = Caml_obj.caml_obj_dup;
  
  function cycle(p) {
    let n = {};
    n.__proto__ = p;
    n.next = n;
    return n;
  }
  
  function id(x) {
    return x;
  }
  
  function backpatched(p) {
    let n = {};
    Caml_obj.update_dummy(n, {
      __proto__: id(p),
      next: n
    });
    return n;
  }
  
  const constant = {
    __proto__: 5,
    other: 1
  };
  
  module.exports = {
    make,
    constant,
    update,
    preserve,
    duplicate,
    cycle,
    id,
    backpatched,
  }
  /* No side effect */
