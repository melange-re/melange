A record field renamed to __proto__ must be an own data property.
Integer and object payloads must survive construction, updates, copies and cycles.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.13)' '(using melange 0.1)' > dune-project
  $ echo '(melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)))' > dune
  $ cat > run.ml <<'ML'
  > type 'a record = { p : 'a [@mel.as "__proto__"]; other : int }
  > let make p = { p; other = 1 }
  > let constant = { p = 5; other = 1 }
  > let update r p = { r with p }
  > let preserve r = { r with other = 2 }
  > let duplicate r = Obj.dup r
  > type 'a node = { next : 'a node; p : 'a [@mel.as "__proto__"] }
  > let cycle p = let rec n = { p; next = n } in n
  > let[@inline never] id x = x
  > let update_try (r : _ record) f = { r with p = (try f () with _ -> r.p) }
  > let backpatched p = let rec n = { p = id p; next = n } in n
  > type 'a writable = { mutable p : 'a [@mel.as "__proto__"]; other : int }
  > let overwrite r first last =
  >   r.p <- first;
  >   let snapshot = r.p in
  >   r.p <- last;
  >   r, snapshot
  > let repeated r first last = overwrite {r with other=2} first last
  > let repeated_copy r first last = overwrite (Obj.obj (Obj.dup (Obj.repr r))) first last
  > ML
