Functions of recursive modules are called directly, both when the modules are
compiled to a [let rec] of functions and when they go through
[Caml_module.init_mod]

  $ . ./setup.sh
  $ cat > dune-project <<EOF
  > (lang dune 3.13)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<EOF
  > (melange.emit
  >  (target output)
  >  (emit_stdlib false))
  > EOF

  $ cat > static.ml <<EOF
  > let calls = ref 0
  > module rec A : sig
  >   val even : int -> bool
  >   val add : int -> int -> int
  > end = struct
  >   let even n = incr calls; n = 0 || B.odd (n - 1)
  >   let add x y = if even x then x + y else B.sub x y
  > end
  > and B : sig
  >   val odd : int -> bool
  >   val sub : int -> int -> int
  > end = struct
  >   let odd n = n <> 0 && A.even (n - 1)
  >   let sub x y = A.add (x - 1) y
  > end
  > let r = A.add 3 4
  > EOF
  $ cat > dynamic.ml <<EOF
  > module rec P : sig
  >   module T : sig
  >     val f : int -> int
  >   end
  >   val g : int -> int -> int
  > end = struct
  >   module T : sig
  >     val f : int -> int
  >   end = struct
  >     let f x = if x = 0 then 0 else P.g (x - 1) 1
  >   end
  >   let g x y = T.f x + y
  > end
  > let use n = P.T.f n + P.g n 2
  > EOF
  $ dune build @melange
  $ cat _build/default/output/static.js
  // Generated by Melange
  'use strict';
  
  
  const calls = {
    contents: 0
  };
  
  function even(n) {
    calls.contents = calls.contents + 1 | 0;
    if (n === 0) {
      return true;
    } else {
      return odd(n - 1 | 0);
    }
  }
  
  function odd(n) {
    if (n !== 0) {
      return even(n - 1 | 0);
    } else {
      return false;
    }
  }
  
  function add(x, y) {
    if (even(x)) {
      return x + y | 0;
    } else {
      return sub(x, y);
    }
  }
  
  function sub(x, y) {
    return add(x - 1 | 0, y);
  }
  
  const A = {
    even,
    add
  };
  
  const B = {
    odd,
    sub
  };
  
  const r = add(3, 4);
  
  module.exports = {
    calls,
    A,
    B,
    r,
  }
  /* r Not a pure module */
  $ cat _build/default/output/dynamic.js
  // Generated by Melange
  'use strict';
  
  const Caml_module = require("melange.js/caml_module.js");
  
  const P = Caml_module.init_mod([
    "dynamic.ml",
    6,
    6
  ], {
    TAG: /* Module */ 0,
    _0: [
      [
        {
          TAG: /* Module */ 0,
          _0: [[
              /* Function */ 0,
              "f"
            ]]
        },
        "T"
      ],
      [
        /* Function */ 0,
        "g"
      ]
    ]
  });
  
  function f(x) {
    if (x === 0) {
      return 0;
    } else {
      return P.g(x - 1 | 0, 1);
    }
  }
  
  const T = {
    f
  };
  
  function g(x, y) {
    return f(x) + y | 0;
  }
  
  Caml_module.update_mod({
    TAG: /* Module */ 0,
    _0: [
      [
        {
          TAG: /* Module */ 0,
          _0: [[
              /* Function */ 0,
              "f"
            ]]
        },
        "T"
      ],
      [
        /* Function */ 0,
        "g"
      ]
    ]
  }, P, {
    T,
    g
  });
  
  function use(n) {
    return P.T.f(n) + P.g(n, 2) | 0;
  }
  
  module.exports = {
    P,
    use,
  }
  /* P Not a pure module */

Effects in the body of a recursive module do not hide the arities of its
functions

  $ cat > effect.ml <<EOF
  > module rec M : sig
  >   val f : int -> int -> int
  > end = struct
  >   let _ = print_endline "init"
  >   let f x y = if x = 0 then y else M.f (x - 1) y
  > end
  > let g a b = M.f a b
  > EOF
  $ dune build @melange
  $ cat _build/default/output/effect.js
  // Generated by Melange
  'use strict';
  
  const Caml_module = require("melange.js/caml_module.js");
  
  const M = Caml_module.init_mod([
    "effect.ml",
    3,
    6
  ], {
    TAG: /* Module */ 0,
    _0: [[
        /* Function */ 0,
        "f"
      ]]
  });
  
  console.log("init");
  
  function f(x, y) {
    if (x === 0) {
      return y;
    } else {
      return M.f(x - 1 | 0, y);
    }
  }
  
  Caml_module.update_mod({
    TAG: /* Module */ 0,
    _0: [[
        /* Function */ 0,
        "f"
      ]]
  }, M, {
    f
  });
  
  function g(a, b) {
    return M.f(a, b);
  }
  
  module.exports = {
    M,
    g,
  }
  /* M Not a pure module */
