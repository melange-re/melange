Literal unit applications use the callee's known uncurried arity (#674).

  $ . ./setup.sh
  $ cat > promise.ml <<'EOF'
  > let sleep ms =
  >   Js.Promise.make @@ fun ~resolve ~reject:_ ->
  >   ignore (Js.Global.setInterval ~f:(fun () -> (resolve () [@u])) ms)
  > EOF
  $ melc -ppx 'melppx -locations-check' promise.ml
  // Generated by Melange
  'use strict';
  
  
  function sleep(ms) {
    return new Promise((function (resolve, param) {
        setInterval((function (param) {
          resolve();
        }), ms);
      }));
  }
  
  module.exports = {
    sleep,
  }
  /* No side effect */

Function construction preserves JavaScript arity, polymorphism and recursion.
Zero-arity tail calls remain stack safe. A computed callee is evaluated once. Labelled unit arguments still select
arity1 explicitly.

  $ cat > functions.ml <<'EOF'
  > module N = struct type t = { x : int } end
  > let apply (f : (N.t -> int) [@u]) = f { N.x = 42 } [@u]
  > let context_value = apply (fun [@u] n -> n.x)
  > let make (f : (unit -> N.t) [@u]) = f () [@u]
  > let context_result = make (fun [@u] () -> { x = 42 })
  > let zero = fun [@u] () -> 42
  > let identity = fun [@u] x -> x
  > let unit_value = identity () [@u]
  > let int_value = identity 42 [@u]
  > let string_value = identity "hello" [@u]
  > let call f = f () [@u]
  > let zero_value = call zero
  > let calls = ref 0
  > let produce () = incr calls; identity
  > let computed_value = (produce ()) () [@u]
  > let labelled = fun [@u] ~value -> value
  > let labelled_value = labelled ~value:() [@u]
  > let rec countdown = fun [@u] n ->
  >   if n = 0 then 0 else countdown (n - 1) [@u]
  > let iterations = ref 0
  > let rec repeat = fun [@u] () ->
  >   incr iterations;
  >   if !iterations < 100000 then repeat () [@u] else !iterations
  > type 'a thunk = ('a -> int) [@u]
  > let unary_iterations = ref 0
  > let rec repeat_unit : unit thunk = fun [@u] _ ->
  >   incr unary_iterations;
  >   if !unary_iterations < 3 then repeat_unit () [@u] else !unary_iterations
  > EOF
  $ melc -ppx 'melppx -locations-check' functions.ml -o functions.js
  $ melc -ppx melppx -i functions.ml
  module N : sig type t = { x : int; } end
  val apply : (N.t -> int [@u]) -> int
  val context_value : int
  val make : (unit -> N.t [@u]) -> N.t
  val context_result : N.t
  val zero : (unit -> int [@u])
  val identity : ('a -> 'a [@u])
  val unit_value : unit
  val int_value : int
  val string_value : string
  val call : (unit -> 'a [@u]) -> 'a
  val zero_value : int
  val calls : int ref
  val produce : unit -> ('a -> 'a [@u])
  val computed_value : unit
  val labelled : (value:'a -> 'a [@u])
  val labelled_value : unit
  val countdown : (int -> int [@u])
  val iterations : int ref
  val repeat : (unit -> int [@u])
  type 'a thunk = ('a -> int [@u])
  val unary_iterations : int ref
  val repeat_unit : unit thunk
  $ node <<'EOF'
  > const assert = require('node:assert/strict');
  > const f = require('./functions.js');
  > assert.equal(f.context_value, 42);
  > assert.equal(f.context_result.x, 42);
  > assert.equal(f.zero.length, 0);
  > assert.equal(f.identity.length, 1);
  > assert.equal(f.unit_value, undefined);
  > assert.equal(f.int_value, 42);
  > assert.equal(f.string_value, 'hello');
  > assert.equal(f.zero_value, 42);
  > assert.equal(f.computed_value, undefined);
  > assert.equal(f.calls.contents, 1);
  > assert.equal(f.labelled.length, 1);
  > assert.equal(f.labelled_value, undefined);
  > assert.equal(f.countdown(3), 0);
  > assert.equal(f.repeat.length, 0);
  > assert.equal(f.repeat(), 100000);
  > assert.equal(f.repeat_unit.length, 1);
  > assert.equal(f.repeat_unit(), 3);
  > EOF

The constructor's syntactic arity must match its expected type.

  $ cat > wrong_arity.ml <<'EOF'
  > let use (f : (unit -> int) [@u]) = f () [@u]
  > let value = use (fun [@u] x -> 42)
  > EOF
  $ melc -ppx melppx -i wrong_arity.ml
  File "wrong_arity.ml", line 2, characters 16-34:
  2 | let value = use (fun [@u] x -> 42)
                      ^^^^^^^^^^^^^^^^^^
  Error: The field Melange$Fn.Call belongs to the record type
           Melange$Fn.arity1 = Js.Fn.arity1
         but a field was expected belonging to the record type Js.Fn.arity0
  [2]

  $ cat > wrong_arity.ml <<'EOF'
  > type 'a callback = ('a -> int) [@u]
  > let use (f : unit callback) = f () [@u]
  > let value = use (fun [@u] () -> 42)
  > EOF
  $ melc -ppx melppx -i wrong_arity.ml
  File "wrong_arity.ml", line 3, characters 16-35:
  3 | let value = use (fun [@u] () -> 42)
                      ^^^^^^^^^^^^^^^^^^^
  Error: The field Melange$Fn.Call belongs to the record type
           Melange$Fn.arity0 = Js.Fn.arity0
         but a field was expected belonging to the record type Js.Fn.arity1
  [2]

Zero-arity externals retain their calling convention.

  $ cat > external_zero.ml <<'EOF'
  > external now : (unit -> float) [@u] = "now" [@@mel.scope "Date"]
  > let timestamp = now () [@u]
  > EOF
  $ melc -ppx 'melppx -locations-check' external_zero.ml
  // Generated by Melange
  'use strict';
  
  
  const timestamp = Date.now();
  
  module.exports = {
    timestamp,
  }
  /* timestamp Not a pure module */

External calls retain their JavaScript receiver for both arities.

  $ cat > receiver.ml <<'EOF'
  > external zero : (unit -> bool) [@u] = "zero" [@@mel.scope "globalThis", "receiver"]
  > external one : (int -> bool) [@u] = "one" [@@mel.scope "globalThis", "receiver"]
  > let zero_receiver = zero () [@u]
  > let one_receiver = one 42 [@u]
  > EOF
  $ melc -ppx 'melppx -locations-check' receiver.ml -o receiver.js
  $ node <<'EOF'
  > 'use strict';
  > const assert = require('node:assert/strict');
  > globalThis.receiver = {
  >   zero() { return this === globalThis.receiver; },
  >   one(value) { return this === globalThis.receiver && value === 42; },
  > };
  > const result = require('./receiver.js');
  > assert.equal(result.zero_receiver, true);
  > assert.equal(result.one_receiver, true);
  > EOF

An unannotated helper still defaults to arity0 before it sees the resolver.

  $ cat > extracted.ml <<'EOF'
  > let call f = f () [@u]
  > let promise : unit Js.Promise.t =
  >   Js.Promise.make (fun ~resolve ~reject:_ -> call resolve)
  > EOF
  $ melc -ppx melppx -i extracted.ml
  File "extracted.ml", line 3, characters 50-57:
  3 |   Js.Promise.make (fun ~resolve ~reject:_ -> call resolve)
                                                        ^^^^^^^
  Error: The value resolve has type ('a -> unit [@u])
         but an expression was expected of type (unit -> 'b [@u])
  [2]

An annotation supplies arity1 before the helper's body is checked. The alias
keeps arity1 when its argument is instantiated to unit.

  $ cat > annotated.ml <<'EOF'
  > type 'a callback = ('a -> unit) [@u]
  > let call (f : unit callback) = f () [@u]
  > let promise = Js.Promise.make (fun ~resolve ~reject:_ -> call resolve)
  > EOF
  $ melc -ppx 'melppx -locations-check' -i annotated.ml
  type 'a callback = ('a -> unit [@u])
  val call : unit callback -> unit
  val promise : unit Js.Promise.t

The argument must still have the right type.

  $ cat > wrong_argument.ml <<'EOF'
  > let call (f : (int -> unit) [@u]) = f () [@u]
  > EOF
  $ melc -ppx melppx -i wrong_argument.ml
  File "wrong_argument.ml", line 1, characters 38-40:
  1 | let call (f : (int -> unit) [@u]) = f () [@u]
                                            ^^
  Error: This expression should not be a unit literal, the expected type is int
  [2]

Reason's existing zero-arity syntax and a unary unit application both work.

  $ cat > reason.re <<'EOF'
  > let zero = (.) => 42;
  > let identity = (. value) => value;
  > let zeroValue = zero(.);
  > let unitValue = identity(. ());
  > let intValue = identity(. 42);
  > let promise = Js.Promise.make((~resolve, ~reject as _) => resolve(. ()));
  > EOF
  $ melc -pp 'refmt --print=binary' -ppx 'melppx -locations-check' -impl reason.re -o reason.js
  $ node <<'EOF'
  > const assert = require('node:assert/strict');
  > const f = require('./reason.js');
  > assert.equal(f.zero.length, 0);
  > assert.equal(f.identity.length, 1);
  > assert.equal(f.zeroValue, 42);
  > assert.equal(f.unitValue, undefined);
  > assert.equal(f.intValue, 42);
  > f.promise.then(value => assert.equal(value, undefined));
  > EOF

The internal shared field adds no ambiguity warnings, even with strict flags.
Warnings in user callee and argument expressions remain enabled.

  $ cat > warnings.ml <<'EOF'
  > let call f = f () [@u]
  > let promise = Js.Promise.make (fun ~resolve ~reject:_ -> resolve () [@u])
  > let identity = fun [@u] value -> value
  > let value = identity 42 [@u]
  > EOF
  $ melc -ppx 'melppx -locations-check' -w +41+42 -warn-error +41+42 warnings.ml -o warnings.js

  $ cat > user_warnings.ml <<'EOF'
  > type a = { callback : ((unit -> int) [@u]); value : int }
  > type b = { callback : ((unit -> int) [@u]); value : int }
  > let callee record = record.callback () [@u]
  > let argument (f : (int -> unit) [@u]) record = f record.value [@u]
  > EOF
  $ melc -ppx melppx -w +41 -warn-error +41 -c user_warnings.ml
  File "user_warnings.ml", line 3, characters 27-35:
  3 | let callee record = record.callback () [@u]
                                 ^^^^^^^^
  Error (warning 41 [ambiguous-name]): callback belongs to several types: 
    b a. The first one was selected. Please disambiguate if this is wrong.
  
  File "user_warnings.ml", line 4, characters 56-61:
  4 | let argument (f : (int -> unit) [@u]) record = f record.value [@u]
                                                              ^^^^^
  Error (warning 41 [ambiguous-name]): value belongs to several types: 
    b a. The first one was selected. Please disambiguate if this is wrong.
  [2]

Editor type checking uses the same field disambiguation.

  $ cat > dune-project <<'EOF'
  > (lang dune 3.8)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<'EOF'
  > (melange.emit
  >  (target output)
  >  (modules promise functions annotated)
  >  (emit_stdlib false)
  >  (preprocess (pps melange.ppx)))
  > EOF
  $ dune build
  $ ocamlmerlin single errors -filename promise.ml < promise.ml | jq '.value'
  []
  $ ocamlmerlin single errors -filename functions.ml < functions.ml | jq '.value'
  []
  $ ocamlmerlin single errors -filename annotated.ml < annotated.ml | jq '.value'
  []
