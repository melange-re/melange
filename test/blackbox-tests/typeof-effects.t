Folding typeof must retain operand calls and exceptions.
The array element and length receiver should both run once.

  $ . ./setup.sh
  $ cat > input.ml <<'ML'
  > external tick : unit -> int = "tick"
  > external array : unit -> int array = "array"
  > let element () = Js.typeof [|tick ()|]
  > let length () = Js.typeof (Array.length (array ()))
  > let pure () = Js.typeof [|1|]
  > ML
  $ melc -ppx melppx -o input.js input.ml
  $ cat input.js
  // Generated by Melange
  'use strict';
  
  
  function element(param) {
    return typeof [tick()];
  }
  
  function length(param) {
    return typeof array().length;
  }
  
  function pure(param) {
    return "object";
  }
  
  module.exports = {
    element,
    length,
    pure,
  }
  /* No side effect */
  $ node <<'JS'
  > const m = require('./input.js');
  > let calls = 0;
  > global.tick = () => {calls++; return 1};
  > global.array = () => {calls++; return [1]};
  > console.log(m.element(), calls);
  > console.log(m.length(), calls);
  > console.log(m.pure(), calls);
  > global.tick = global.array = () => {throw new Error('operand')};
  > for (const name of ['element', 'length']) {
  >   try { console.log(name, m[name]()); }
  >   catch (e) { console.log(name, e.message); }
  > }
  > JS
  object 1
  number 2
  object 2
  element operand
  length operand
