Subtracting from positive zero differs from negation at positive zero.
The generated functions must agree with JavaScript subtraction and negation.

  $ . ./setup.sh
  $ cat > run.ml <<'ML'
  > let subtract x = 0. -. x
  > let subtract_int x = float_of_int 0 -. x
  > let negate x = -. x
  > let nested x = float_of_int 0 -. (float_of_int 0 -. x)
  > let negative_zero x = -0. -. x
  > let integer x = -x
  > external next : unit -> float = "next"
  > let effects () = 0. -. next ()
  > ML
  $ melc -ppx melppx -o run.js run.ml
  $ cat run.js
  // Generated by Melange
  'use strict';
  
  
  function subtract(x) {
    return - x;
  }
  
  function subtract_int(x) {
    return -x;
  }
  
  function negate(x) {
    return - x;
  }
  
  function nested(x) {
    return --x;
  }
  
  function negative_zero(x) {
    return -0 - x;
  }
  
  function integer(x) {
    return -x | 0;
  }
  
  function effects(param) {
    return - next();
  }
  
  module.exports = {
    subtract,
    subtract_int,
    negate,
    nested,
    negative_zero,
    integer,
    effects,
  }
  /* No side effect */
  $ node --check run.js
  $ node <<'JS'
  > const m = require('./run.js');
  > for (const x of [0, -0, 1, -1, Infinity, -Infinity, NaN]) {
  >   console.log(x, Object.is(m.subtract(x), 0 - x), Object.is(m.subtract_int(x), 0 - x),
  >     Object.is(m.negate(x), -x), Object.is(m.nested(x), 0 - (0 - x)), Object.is(m.negative_zero(x), -0 - x));
  > }
  > console.log('integer', m.integer(0), m.integer(-2147483648));
  > let calls = 0; global.next = () => {calls++; return 0};
  > console.log('effects', 1 / m.effects(), calls);
  > global.next = () => {throw new Error('operand')};
  > try {m.effects()} catch (e) {console.log(e.message)}
  > JS
  0 false false true false true
  -0 true true true false true
  1 true true true false true
  -1 true true true false true
  Infinity true true true true true
  -Infinity true true true true true
  NaN true true true true true
  integer 0 -2147483648
  effects -Infinity 1
  operand
