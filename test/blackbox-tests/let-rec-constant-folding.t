An acyclic chain in a recursive binding group should still fold to a constant.

  $ . ./setup.sh
  $ cat > input.ml <<'EOF'
  > let answer () =
  >   let rec f x = g x
  >   and g x = h x
  >   and h x = x + 1 in
  >   f 41
  > EOF
  $ melc input.ml > input.js
  $ cat input.js
  // Generated by Melange
  'use strict';
  
  
  function answer(param) {
    let x = 41;
    return x + 1 | 0;
  }
  
  module.exports = {
    answer,
  }
  /* No side effect */
  $ node -p 'require("./input.js").answer()'
  42
