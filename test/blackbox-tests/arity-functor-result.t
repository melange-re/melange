The arities of the functions defined in the body of a functor are known at
its applications in other modules. A field bound to a function of the
argument has no known arity

  $ . ./setup.sh
  $ cat > dune-project <<EOF
  > (lang dune 3.13)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<EOF
  > (melange.emit
  >  (target output)
  >  (emit_stdlib false))
  > EOF

  $ cat > tbl.ml <<EOF
  > module type S = sig
  >   type t
  >   val hash : t -> int
  >   val combine : t -> t -> int
  > end
  > module Make (X : S) = struct
  >   let combine = X.combine
  >   let size t = X.hash t land 15
  >   let mix t u = size t + size u
  > end
  > EOF
  $ cat > main.ml <<EOF
  > let seed = ref 3
  > module T = Tbl.Make (struct
  >   type t = int
  >   let hash x = x * !seed
  >   let combine x y = x + y * !seed
  > end)
  > let m = T.mix 1 2
  > let c = T.combine 1 2
  > EOF
  $ dune build @melange
  $ cat _build/default/output/main.js
  // Generated by Melange
  'use strict';
  
  const Curry = require("melange.js/curry.js");
  const Melange__Tbl = require("./tbl.js");
  
  const seed = {
    contents: 3
  };
  
  function hash(x) {
    return Math.imul(x, seed.contents);
  }
  
  function combine(x, y) {
    return x + Math.imul(y, seed.contents) | 0;
  }
  
  const T = Melange__Tbl.Make({
    hash,
    combine
  });
  
  const m = T.mix(1, 2);
  
  const c = Curry._2(T.combine, 1, 2);
  
  module.exports = {
    seed,
    T,
    m,
    c,
  }
  /* T Not a pure module */
