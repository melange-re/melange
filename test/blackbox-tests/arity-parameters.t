A parameter of a local function that does not escape gets the arity of the
arguments passed at its call sites; passing it unchanged to a recursive call
does not count

  $ . ./setup.sh
  $ cat > main.ml <<EOF
  > let sum xs =
  >   let rec go f acc = function
  >     | [] -> acc
  >     | x :: rest -> go f (f acc x) rest
  >   in
  >   go (fun acc x -> acc + x) 0 xs
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  
  function sum(xs) {
    let f = function (acc, x) {
      return acc + x | 0;
    };
    let _acc = 0;
    let _param = xs;
    while (true) {
      const param = _param;
      const acc = _acc;
      if (!param) {
        return acc;
      }
      _param = param.tl;
      _acc = f(acc, param.hd);
      continue;
    };
  }
  
  module.exports = {
    sum,
  }
  /* No side effect */

The arity is unknown when one of the call sites passes a function of unknown
arity

  $ cat > main.ml <<EOF
  > let sum h xs =
  >   let rec go f acc = function
  >     | [] -> acc
  >     | x :: rest -> go f (f acc x) rest
  >   in
  >   go (fun acc x -> acc + x) 0 xs + go h 0 xs
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  const Curry = require("melange.js/curry.js");
  
  function sum(h, xs) {
    const go = function (f, _acc, _param) {
      while (true) {
        const param = _param;
        const acc = _acc;
        if (!param) {
          return acc;
        }
        _param = param.tl;
        _acc = Curry._2(f, acc, param.hd);
        continue;
      };
    };
    return go((function (acc, x) {
      return acc + x | 0;
    }), 0, xs) + go(h, 0, xs) | 0;
  }
  
  module.exports = {
    sum,
  }
  /* No side effect */
