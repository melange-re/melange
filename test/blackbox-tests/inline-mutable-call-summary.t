Calls through a function reference returned by an inlined functor must use
the reassigned function, including when its initializer wraps a primitive.

  $ . ./setup.sh
  $ cat > dune-project <<'EOF'
  > (lang dune 3.13)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<'EOF'
  > (melange.emit
  >  (target out)
  >  (emit_stdlib false)
  >  (compile_flags :standard --mel-cross-module-opt)
  >  (libraries melange.js)
  >  (module_systems (commonjs js) (esm mjs)))
  > EOF
  $ cat > provider.ml <<'EOF'
  > module Make (X : sig val flag : bool end) = struct
  >   let f =
  >     let r = ref (fun x y -> x - y) in
  >     if X.flag then r := (fun x y -> x + y);
  >     !r
  > end
  > EOF
  $ cat > input.ml <<'EOF'
  > module M = Provider.Make (struct let flag = true end)
  > let result = M.f 40 2
  > let () = assert (result = 42)
  > EOF
  $ dune build @melange
  $ cat _build/default/out/input.js
  // Generated by Melange
  'use strict';
  
  const Caml_js_exceptions = require("melange.js/caml_js_exceptions.js");
  const Curry = require("melange.js/curry.js");
  
  const X = {
    flag: true
  };
  
  function r(x, y) {
    return x - y | 0;
  }
  
  if (X.flag) {
    r = (function (x, y) {
      return x + y | 0;
    });
  }
  
  const f = r;
  
  const M = {
    f
  };
  
  const result = Curry._2(M.f, 40, 2);
  
  if (result !== 42) {
    throw new Caml_js_exceptions.MelangeError("Assert_failure", {
        MEL_EXN_ID: "Assert_failure",
        _1: [
          "input.ml",
          3,
          9
        ]
      });
  }
  
  module.exports = {
    M,
    result,
  }
  /* M Not a pure module */
  $ node _build/default/out/input.js
  $ node _build/default/out/input.mjs
