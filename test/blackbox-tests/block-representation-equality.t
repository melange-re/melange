Block equality must preserve record fields and constructor representations.
No casts are needed: each branch passes its value to a polymorphic JS binding.
Direct values, folded calls and runtime calls must agree.
The X and Z arms may merge; Y must retain its different representation.
Y must keep y = 1, x = 2, and the "second" or "right" constructor tags.

  $ . ./setup.sh
  $ cat > input.ml <<'EOF'
  > type source = X | Y | Z
  > type xy = { x : int; y : int }
  > type yx = { y : int; x : int }
  > type first = First of int [@mel.as "first"] | Other_first of int
  > type second = Second of int [@mel.as "second"] | Other_second of int
  > type left = Left of { x : int; y : int } [@mel.as "left"] | Other_left of int
  > type right = Right of { y : int; x : int } [@mel.as "right"] | Other_right of int
  > external emit : 'a -> unit = "emit"
  > let records = function
  >   | X | Z -> emit ({x = 1; y = 2} : xy)
  >   | Y -> emit ({y = 1; x = 2} : yx)
  > let variants = function
  >   | X | Z -> emit (First 1)
  >   | Y -> emit (Second 1)
  > let record_if b n =
  >   if b then emit ({x = n; y = 2} : xy) else emit ({y = n; x = 2} : yx)
  > let variant_if b n = if b then emit (First n) else emit (Second n)
  > let inline_if b n =
  >   if b then emit (Left {x = n; y = 2}) else emit (Right {y = n; x = 2})
  > let nested = function
  >   | X | Z -> emit (Some (Some ({x = 1; y = 2} : xy)))
  >   | Y -> emit (Some (Some ({y = 1; x = 2} : yx)))
  > let direct () =
  >   emit ({y = 1; x = 2} : yx); emit (Second 1); emit (Right {y = 1; x = 2})
  > let folded () = records Y; variants Y; nested Y
  > EOF
  $ melc -ppx melppx -o input.js input.ml
  $ cat input.js
  // Generated by Melange
  'use strict';
  
  
  function records(param) {
    switch (param) {
      case /* X */ 0 :
      case /* Y */ 1 :
      case /* Z */ 2 :
        emit({
          x: 1,
          y: 2
        });
        return;
    }
  }
  
  function variants(param) {
    switch (param) {
      case /* X */ 0 :
      case /* Y */ 1 :
      case /* Z */ 2 :
        emit({
          TAG: /* First */ "first",
          _0: 1
        });
        return;
    }
  }
  
  function record_if(b, n) {
    emit({
      x: n,
      y: 2
    });
  }
  
  function variant_if(b, n) {
    emit({
      TAG: /* First */ "first",
      _0: n
    });
  }
  
  function inline_if(b, n) {
    emit({
      TAG: /* Left */ "left",
      x: n,
      y: 2
    });
  }
  
  function nested(param) {
    switch (param) {
      case /* X */ 0 :
      case /* Y */ 1 :
      case /* Z */ 2 :
        emit({
          x: 1,
          y: 2
        });
        return;
    }
  }
  
  function direct(param) {
    emit({
      y: 1,
      x: 2
    });
    emit({
      TAG: /* Second */ "second",
      _0: 1
    });
    emit({
      TAG: /* Right */ "right",
      y: 1,
      x: 2
    });
  }
  
  function folded(param) {
    emit({
      y: 1,
      x: 2
    });
    emit({
      TAG: /* Second */ "second",
      _0: 1
    });
    emit({
      y: 1,
      x: 2
    });
  }
  
  module.exports = {
    records,
    variants,
    record_if,
    variant_if,
    inline_if,
    nested,
    direct,
    folded,
  }
  /* No side effect */
