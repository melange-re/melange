Recursive blocks behind effects must keep their placeholder and backpatching.
Each function must preserve its cycle and evaluate each initializer once.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.13)' '(using melange 0.1)' > dune-project
  $ echo '(melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)) (compile_flags :standard -w -23))' > dune
  $ cat > run.ml <<'ML'
  > type node = { next : node; value : int }
  > let calls = ref 0
  > let[@inline never] id x = incr calls; x
  > let source () = incr calls; let rec n = {next=n;value=0} in n
  > let sequence () = let rec n = incr calls; {next=n;value=1} in n
  > let binding () = let rec n = let v = id 2 in {next=n;value=v} in n
  > let spread () = let rec n = {(source ()) with next=n;value=3} in n
  > let mutual () =
  >  let rec a = incr calls; {next=b;value=4}
  >  and b = let v = id 5 in {next=a;value=v} in a
  > let plain () = let rec n = {next=n;value=6} in n
  > type array_node = { next : array_node [@mel.as "0"]; value : int [@mel.as "1"] }
  > let array_cycle () = let rec n = let v = id 7 in {next=n;value=v} in n
  > ML
  $ dune build @melange
  $ cat _build/default/out/run.js
  // Generated by Melange
  'use strict';
  
  
  const calls = {
    contents: 0
  };
  
  function id(x) {
    calls.contents = calls.contents + 1 | 0;
    return x;
  }
  
  function source(param) {
    calls.contents = calls.contents + 1 | 0;
    let n = {};
    n.next = n;
    n.value = 0;
    return n;
  }
  
  function sequence(param) {
    calls.contents = calls.contents + 1 | 0;
    const n = {
      next: n,
      value: 1
    };
    return n;
  }
  
  function binding(param) {
    const v = id(2);
    const n = {
      next: n,
      value: v
    };
    return n;
  }
  
  function spread(param) {
    source();
    const n = {
      next: n,
      value: 3
    };
    return n;
  }
  
  function mutual(param) {
    calls.contents = calls.contents + 1 | 0;
    const a = {
      next: b,
      value: 4
    };
    const v = id(5);
    const b = {
      next: a,
      value: v
    };
    return a;
  }
  
  function plain(param) {
    let n = {};
    n.next = n;
    n.value = 6;
    return n;
  }
  
  function array_cycle(param) {
    const v = id(7);
    const n = [
      n,
      v
    ];
    return n;
  }
  
  module.exports = {
    calls,
    id,
    source,
    sequence,
    binding,
    spread,
    mutual,
    plain,
    array_cycle,
  }
  /* No side effect */
  $ node --check _build/default/out/run.js
  $ node <<'JS'
  > const m = require('./_build/default/out/run.js');
  > for (const name of ['sequence', 'binding', 'spread', 'mutual', 'plain', 'array_cycle']) {
  >   m.calls.contents = 0;
  >   try {
  >     const n = m[name]();
  >     const next = Array.isArray(n) ? n[0] : n.next;
  >     const next2 = Array.isArray(next) ? next[0] : next.next;
  >     console.log(name, next === n, next2 === n, Array.isArray(n), m.calls.contents);
  >   } catch (e) { console.log(name, e.name, m.calls.contents); }
  > }
  > JS
  sequence ReferenceError 1
  binding ReferenceError 1
  spread ReferenceError 1
  mutual ReferenceError 1
  plain true true false 0
  array_cycle ReferenceError 1
