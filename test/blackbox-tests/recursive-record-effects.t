Recursive blocks behind effects must keep their placeholder and backpatching.
Each function must preserve its cycle and evaluate each initializer once.
A recursive group read only by closures needs no placeholder for its record.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.13)' '(using melange 0.1)' > dune-project
  $ echo '(melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)) (compile_flags :standard -w -23))' > dune
  $ cat > run.ml <<'ML'
  > type node = { next : node; value : int }
  > let calls = ref 0
  > let[@inline never] id x = incr calls; x
  > let source () = incr calls; let rec n = {next=n;value=0} in n
  > let sequence () = let rec n = incr calls; {next=n;value=1} in n
  > let binding () = let rec n = let v = id 2 in {next=n;value=v} in n
  > let spread () = let rec n = {(source ()) with next=n;value=3} in n
  > let mutual () =
  >  let rec a = incr calls; {next=b;value=4}
  >  and b = let v = id 5 in {next=a;value=v} in a
  > let plain () = let rec n = {next=n;value=6} in n
  > type array_node = { next : array_node [@mel.as "0"]; value : int [@mel.as "1"] }
  > let array_cycle () = let rec n = let v = id 7 in {next=n;value=v} in n
  > let nested () =
  >  let rec n : node =
  >   let rec retry k = if k > 0 then retry (k-1) else id 8 in
  >   print_endline "nested initializer";
  >   {next=n;value=retry (id 2)} in n
  > let nested_source () =
  >  let rec n = {
  >   (let rec retry k = if k > 0 then retry (k-1) else (print_endline "nested source"; source ()) in
  >    retry (id 2)) with next=n;value=9} in n
  > type counter = { start : int; step : unit -> int }
  > let rec next_count () = counter.start + 1
  > and counter = incr calls; { start = id 10; step = (fun () -> next_count ()) }
  > ML
  $ cat > module_level.ml <<'ML'
  > type node = { next : node; value : int }
  > let rec n =
  >  let rec retry k = if k > 0 then retry (k-1) else Run.id 12 in
  >  print_endline "module initializer";
  >  {next=n;value=retry (Run.id 2)}
  > ML
  $ dune build @melange
  $ cat _build/default/out/run.js
  // Generated by Melange
  'use strict';
  
  
  const calls = {
    contents: 0
  };
  
  function id(x) {
    calls.contents = calls.contents + 1 | 0;
    return x;
  }
  
  function source(param) {
    calls.contents = calls.contents + 1 | 0;
    let n = {};
    n.next = n;
    n.value = 0;
    return n;
  }
  
  function sequence(param) {
    calls.contents = calls.contents + 1 | 0;
    const n = {
      next: n,
      value: 1
    };
    return n;
  }
  
  function binding(param) {
    const v = id(2);
    const n = {
      next: n,
      value: v
    };
    return n;
  }
  
  function spread(param) {
    source();
    const n = {
      next: n,
      value: 3
    };
    return n;
  }
  
  function mutual(param) {
    calls.contents = calls.contents + 1 | 0;
    const a = {
      next: b,
      value: 4
    };
    const v = id(5);
    const b = {
      next: a,
      value: v
    };
    return a;
  }
  
  function plain(param) {
    let n = {};
    n.next = n;
    n.value = 6;
    return n;
  }
  
  function array_cycle(param) {
    const v = id(7);
    const n = [
      n,
      v
    ];
    return n;
  }
  
  function nested(param) {
    const retry = function (_k) {
      while (true) {
        const k = _k;
        if (k <= 0) {
          return id(8);
        }
        _k = k - 1 | 0;
        continue;
      };
    };
    console.log("nested initializer");
    const n_value = retry(id(2));
    const n = {
      next: n,
      value: n_value
    };
    return n;
  }
  
  function nested_source(param) {
    const retry = function (_k) {
      while (true) {
        const k = _k;
        if (k > 0) {
          _k = k - 1 | 0;
          continue;
        }
        console.log("nested source");
        return source();
      };
    };
    retry(id(2));
    const n = {
      next: n,
      value: 9
    };
    return n;
  }
  
  calls.contents = calls.contents + 1 | 0;
  
  const counter_start = id(10);
  
  function counter_step(param) {
    return counter.start + 1 | 0;
  }
  
  const counter = {
    start: counter_start,
    step: counter_step
  };
  
  function next_count(param) {
    return counter_start + 1 | 0;
  }
  
  module.exports = {
    calls,
    id,
    source,
    sequence,
    binding,
    spread,
    mutual,
    plain,
    array_cycle,
    nested,
    nested_source,
    next_count,
    counter,
  }
