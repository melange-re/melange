User modules must not intercept the helpers generated by [@mel.open].
The three handlers should return Some 1; runtime array helpers remain unaffected.
ReScript #9160 exposed the analogous problem in its %todo expansion.

  $ . ./setup.sh
  $ cat > dune-project <<'EOF'
  > (lang dune 3.9)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<'EOF'
  > (melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)))
  > EOF
  $ cat > input.ml <<'EOF'
  > [@@@warning "-32"]
  > let baseline = (function [@mel.open] Not_found -> 1) Not_found
  > let shadow_js =
  >   let module Js = struct
  >     module Exn = struct let isCamlExceptionOrOpenVariant _ = false end
  >   end in
  >   (function [@mel.open] Not_found -> 1) Not_found
  > let shadow_obj =
  >   let module Obj = struct let magic _ = Invalid_argument "intercepted" end in
  >   (function [@mel.open] Not_found -> 1 | Invalid_argument _ -> 2) Not_found
  > module Caml_array = struct let get _ _ = 99 end
  > let get a i = a.(i)
  > EOF
  $ dune build @melange
  $ node <<'EOF'
  > const m = require('./_build/default/out/input.js');
  > console.log(m.baseline, m.shadow_js, m.shadow_obj, m.get([7], 0));
  > EOF
  1 1 1 7
