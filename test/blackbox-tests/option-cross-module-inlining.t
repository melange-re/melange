  const Caml_option = require("melange.js/caml_option.js");
  const Curry = require("melange.js/curry.js");
  
  function mapped(o) {
    if (o !== undefined) {
      return Caml_option.some(Curry._1((function (x) {
        return x + 1 | 0;
      }), Caml_option.valFromOption(o)));
    }
    
  }
  
  function bound(o) {
    if (o !== undefined) {
      let x = Caml_option.valFromOption(o);
      return x + 2 | 0;
    }
    
  }
  
  function folded(o) {
    if (o !== undefined) {
      let x = Caml_option.valFromOption(o);
      return x + 3 | 0;
    } else {
      return 0;
    }
  }
  
  function value(o) {
    if (o !== undefined) {
      return Caml_option.valFromOption(o);
    } else {
      return 0;
    }
  }
  
  function join_some(o) {
    return o;
  }
  
  function each(o, f) {
    if (o !== undefined) {
      return Curry._1(f, Caml_option.valFromOption(o));
    }
    
  }
  
  function identity(o) {
    if (o !== undefined) {
      return Caml_option.some(Curry._1((function (x) {
        return x;
      }), Caml_option.valFromOption(o)));
    }
    
  }
  
  const o = 3;
  
  const known = o !== undefined ? Caml_option.valFromOption(o) : 0;
  
  module.exports = {
    mapped,
    bound,
    folded,
    value,
    join_some,
    each,
    identity,
    known,
  }
  /* No side effect */
