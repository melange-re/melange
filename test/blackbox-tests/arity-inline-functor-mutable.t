Inlining a functor must preserve the bindings of mutable locals, even when
the branch that assigns to the reference is never taken.

The generated input.js exposes an existing binding mismatch: it declares r
but assigns r$1. The false flag keeps that assignment from executing. #2191
inlines the functor earlier, in Lambda, where the unbound assignment causes
a compiler error instead.

  $ . ./setup.sh
  $ cat > dune-project <<'EOF'
  > (lang dune 3.13)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<'EOF'
  > (melange.emit
  >  (target out)
  >  (emit_stdlib false)
  >  (compile_flags :standard --mel-cross-module-opt)
  >  (libraries melange.js)
  >  (module_systems (commonjs js) (esm mjs)))
  > EOF
  $ cat > provider.ml <<'EOF'
  > module Make (X : sig val flag : bool end) = struct
  >   let value =
  >     let r = ref 0 in
  >     if X.flag then r := 42;
  >     !r
  > end
  > EOF
  $ cat > input.ml <<'EOF'
  > module M = Provider.Make (struct let flag = false end)
  > let () = assert (M.value = 0)
  > EOF
  $ dune build @melange
  $ cat _build/default/out/provider.js
  // Generated by Melange
  'use strict';
  
  
  function Make(X) {
    let r = 0;
    if (X.flag) {
      r = 42;
    }
    const value = r;
    return {
      value
    };
  }
  
  module.exports = {
    Make,
  }
  /* No side effect */
  $ cat _build/default/out/input.js
  // Generated by Melange
  'use strict';
  
  const Caml_js_exceptions = require("melange.js/caml_js_exceptions.js");
  
  const X = {
    flag: false
  };
  
  let r = 0;
  
  if (X.flag) {
    r$1 = 42;
  }
  
  const value = r;
  
  const M = {
    value
  };
  
  if (M.value !== 0) {
    throw new Caml_js_exceptions.MelangeError("Assert_failure", {
        MEL_EXN_ID: "Assert_failure",
        _1: [
          "input.ml",
          2,
          9
        ]
      });
  }
  
  module.exports = {
    M,
  }
  /* M Not a pure module */
  $ node _build/default/out/input.js
  $ node _build/default/out/input.mjs
