A local binding to a value that is not syntactically a function keeps the
arity of that value, so applying it is a direct call

  $ . ./setup.sh
  $ cat > main.ml <<EOF
  > let add x y = x + y
  > let sub x y = x - y
  > let pick c x =
  >   let g = if c then add else sub in
  >   g x 1 + g 1 x
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  
  function add(x, y) {
    return x + y | 0;
  }
  
  function sub(x, y) {
    return x - y | 0;
  }
  
  function pick(c, x) {
    const g = c ? add : sub;
    return g(x, 1) + g(1, x) | 0;
  }
  
  module.exports = {
    add,
    sub,
    pick,
  }
  /* No side effect */
