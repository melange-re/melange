Dotted global externals must keep their root names free of local bindings.
Calls and reads should use the global value, including method receivers.

  $ . ./setup.sh
  $ cat > input.ml <<'ML'
  > external value : unit -> int = "shadowTarget.value"
  > external scoped : unit -> int = "value" [@@mel.scope "shadowTarget.nested"]
  > external separate : unit -> int = "value" [@@mel.scope "shadowTarget", "nested"]
  > external read : int = "shadowTarget.number"
  > let dotted shadowTarget = shadowTarget, value ()
  > let nested shadowTarget = shadowTarget, scoped ()
  > let control shadowTarget = shadowTarget, separate ()
  > let field shadowTarget = shadowTarget, read
  > ML
  $ melc -ppx melppx -o input.js input.ml
  $ cat input.js
  // Generated by Melange
  'use strict';
  
  
  function dotted(shadowTarget$1) {
    return [
      shadowTarget$1,
      shadowTarget.value()
    ];
  }
  
  function nested(shadowTarget$1) {
    return [
      shadowTarget$1,
      shadowTarget.nested.value()
    ];
  }
  
  function control(shadowTarget$1) {
    return [
      shadowTarget$1,
      shadowTarget.nested.value()
    ];
  }
  
  function field(shadowTarget$1) {
    return [
      shadowTarget$1,
      shadowTarget.number
    ];
  }
  
  module.exports = {
    dotted,
    nested,
    control,
    field,
  }
