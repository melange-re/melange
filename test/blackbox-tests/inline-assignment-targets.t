Cross-module inlining must rename assignments to local mutable variables.
Both calls should return 14, and the constant calls should return [12, 4].

  $ . ./setup.sh
  $ cat > lib.ml <<'ML'
  > let[@inline always] bump x =
  >   let r = ref x in
  >   incr r;
  >   if x > 3 then r := !r * 2;
  >   !r
  > let[@inline never] control x =
  >   let r = ref x in
  >   incr r;
  >   if x > 3 then r := !r * 2;
  >   !r
  > ML
  $ cat > run.ml <<'ML'
  > let twice x y = Lib.bump x + Lib.bump y
  > let constants = Lib.bump 5, Lib.bump 3
  > let control x y = Lib.control x + Lib.control y
  > ML
  $ melc --mel-cross-module-opt -o lib.js lib.ml
  $ melc --mel-cross-module-opt -I . -o run.js run.ml
  $ cat run.js
  // Generated by Melange
  'use strict';
  
  const Lib = require("./lib.js");
  
  function twice(x, y) {
    let r = x;
    r = r + 1 | 0;
    if (x > 3) {
      r = (r << 1);
    }
    let r$1 = y;
    r$1 = r$1 + 1 | 0;
    if (y > 3) {
      r$1 = (r$1 << 1);
    }
    return r + r$1 | 0;
  }
  
  let r = 5;
  
  r = r + 1 | 0;
  
  r = (r << 1);
  
  let r$1 = 3;
  
  r$1 = r$1 + 1 | 0;
  
  const constants = [
    r,
    r$1
  ];
  
  function control(x, y) {
    return Lib.control(x) + Lib.control(y) | 0;
  }
  
  module.exports = {
    twice,
    constants,
    control,
  }
  /* constants Not a pure module */
  $ node --check run.js
  $ node -e 'const m = require("./run.js"); console.log(m.twice(3,4), m.control(3,4), m.constants)'
  14 14 [ 12, 4 ]
