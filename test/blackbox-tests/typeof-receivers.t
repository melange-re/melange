Member access must apply to the result of typeof. Function receivers are controls.

  $ . ./setup.sh
  $ cat > input.ml <<'EOF'
  > external length : 'a -> int = "length" [@@mel.get]
  > external upper : string -> string = "toUpperCase" [@@mel.send]
  > external char : string -> int -> string = "charAt" [@@mel.send]
  > external call : ('a -> 'b) -> unit Js.Nullable.t -> 'a -> 'b = "call" [@@mel.send]
  > let len x = length (Js.typeof x)
  > let up x = upper (Js.typeof x)
  > let nested x = length (upper (Js.typeof x))
  > let index x = char (Js.typeof x) 0
  > let arity () = length (fun x -> x + 1)
  > let called () = call (fun x -> x + 1) Js.Nullable.null 4
  > external next : unit -> string = "next"
  > let effectful () = upper (Js.typeof (next ()))
  > let raw () = length ([%mel.raw {|x => x + 1|}] : int -> int)
  > let equal () = (fun n -> n + 1) == (fun n -> n + 1)
  > external invoke : (int -> int) -> int = "invoke"
  > let ternary b = invoke (if b then (fun n -> n + 1) else (fun n -> n + 2))
  > let seen = ref 0
  > let statement () =
  >   ignore (call (fun n -> seen := n; n) Js.Nullable.null 4);
  >   !seen
  > let async () = length ([%mel.raw {|async x => x + 1|}] : int -> int Js.Promise.t)
  > let async_equal () = ([%mel.raw {|async x => x + 1|}] : int -> int Js.Promise.t) == [%mel.raw {|async x => x + 1|}]
  > EOF
  $ melc --color=never -ppx melppx -o input.js input.ml
  $ cat input.js
  // Generated by Melange
  'use strict';
  
  
  function len(x) {
    return (typeof x).length;
  }
  
  function up(x) {
    return (typeof x).toUpperCase();
  }
  
  function nested(x) {
    return (typeof x).toUpperCase().length;
  }
  
  function index(x) {
    return (typeof x).charAt(0);
  }
  
  function arity(param) {
    return (function (x) {
      return x + 1 | 0;
    }).length;
  }
  
  function called(param) {
    return (function (x) {
      return x + 1 | 0;
    }).call(null, 4);
  }
  
  function effectful(param) {
    return (typeof next()).toUpperCase();
  }
  
  function raw(param) {
    return (x => x + 1
    ).length;
  }
  
  function equal(param) {
    return (function (n) {
      return n + 1 | 0;
    }) === (function (n) {
      return n + 1 | 0;
    });
  }
  
  function ternary(b) {
    return invoke(b ? (function (n) {
        return n + 1 | 0;
      }) : (function (n) {
        return n + 2 | 0;
      }));
  }
  
  const seen = {
    contents: 0
  };
  
  function statement(param) {
    (function (n) {
      seen.contents = n;
      return n;
    }).call(null, 4);
    return seen.contents;
  }
  
  function async(param) {
    return (async x => x + 1
    ).length;
  }
  
  function async_equal(param) {
    return (async x => x + 1
    ) === (async x => x + 1
    );
  }
  
  module.exports = {
    len,
    up,
    nested,
    index,
    arity,
    called,
    effectful,
    raw,
    equal,
    ternary,
    seen,
    statement,
    async,
    async_equal,
  }
  /* No side effect */
  $ node --check input.js
  $ node <<'EOF'
  > const t = require('./input.js');
  > console.log('typeof:', t.len('abc'), t.up('abc'), t.nested('abc'), t.index('abc'));
  > console.log('functions:', t.arity(), t.called(), t.raw());
  > let calls = 0;
  > global.next = () => { ++calls; return 'abc'; };
  > console.log('effect:', t.effectful(), calls);
  > global.invoke = f => f(1);
  > console.log('operands:', t.equal(), t.ternary(true), t.ternary(false));
  > console.log('statement:', t.statement());
  > console.log('async:', t.async(), t.async_equal());
  > EOF
  typeof: 6 STRING 6 s
  functions: 1 5 1
  effect: STRING 1
  operands: false 2 3
  statement: 4
  async: 1 false
