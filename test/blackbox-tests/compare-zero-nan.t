Comparison with zero must keep the total ordering of compare, including nested NaN.
Each pair below should agree; main incorrectly uses structural equality.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.9)' '(using melange 0.1)' > dune-project
  $ cat > dune <<'DUNE'
  > (melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)))
  > DUNE
  $ cat > input.ml <<'ML'
  > let same a b = compare a b = 0
  > let different a b = compare a b <> 0
  > let runtime a b = compare a b
  > ML
  $ dune build @melange
  $ cat _build/default/out/input.js
  // Generated by Melange
  'use strict';
  
  const Caml_obj = require("melange.js/caml_obj.js");
  
  const same = Caml_obj.caml_equal;
  
  function different(a, b) {
    return Caml_obj.caml_compare(a, b) !== 0;
  }
  
  const runtime = Caml_obj.caml_compare;
  
  module.exports = {
    same,
    different,
    runtime,
  }
  /* No side effect */
  $ node <<'JS'
  > const m = require('./_build/default/out/input.js');
  > for (const [name, a, b] of [
  >   ['NaN', NaN, NaN], ['record NaN', {x: NaN}, {x: NaN}],
  >   ['array NaN', [NaN], [NaN]], ['nested NaN', [{x: NaN}], [{x: NaN}]],
  >   ['record', {x: 1}, {x: 1}], ['array', [10], [9]],
  >   ['negative', -1, -1], ['string', 'x', 'x'], ['bool', true, false]
  > ]) console.log(name, m.same(a,b), m.runtime(a,b) === 0, m.different(a,b), m.runtime(a,b) !== 0);
  > JS
  NaN false true false false
  record NaN false true false false
  array NaN false true false false
  nested NaN false true false false
  record true true false false
  array false false true true
  negative true true false false
  string true true false false
  bool false false true true
