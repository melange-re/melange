Generated uncurried calls do not trigger warning 20. Their argument types and
labels remain inferred, including under polymorphic bindings and local types.

  $ . ./setup.sh
  $ cat > accepted.ml <<'EOF'
  > external obj : unit -> < .. > Js.t = "obj"
  > external unknown_fn : unit -> 'a = "unknown_fn"
  > let method_call () : int = (obj ())##m "text"
  > let property_call () : int = (obj ())#@fn "text"
  > let generic_call () : int = ((unknown_fn ()) "text" [@u])
  > let labelled = (fun ~x ~y -> x + y) [@u]
  > let reordered = (labelled ~y:2 ~x:1 [@u])
  > let locally_abstract (type a) (fn : (a -> a [@u])) (value : a) =
  >   fn value [@u]
  > let polymorphic () =
  >   let apply value = ((unknown_fn ()) value [@u]) in
  >   (apply 1 : int), (apply true : bool)
  > EOF
  $ melc -ppx 'melppx -locations-check' -w +20 -warn-error +20 -c accepted.ml
  // Generated by Melange
  'use strict';
  
  
  function method_call(param) {
    return obj().m("text");
  }
  
  function property_call(param) {
    return obj().fn("text");
  }
  
  function generic_call(param) {
    return unknown_fn()("text");
  }
  
  function labelled(x, y) {
    return x + y | 0;
  }
  
  const reordered = labelled(1, 2);
  
  function locally_abstract(fn, value) {
    return fn(value);
  }
  
  function polymorphic(param) {
    const apply = function (value) {
      return unknown_fn()(value);
    };
    return [
      apply(1),
      apply(true)
    ];
  }
  
  module.exports = {
    method_call,
    property_call,
    generic_call,
    labelled,
    reordered,
    locally_abstract,
    polymorphic,
  }
  /* reordered Not a pure module */

The PPX currently suppresses warning 20 in user arguments and callees,
including when nested inside another generated uncurried call.

  $ cat > rejected.ml <<'EOF'
  > external obj : unit -> < .. > Js.t = "obj"
  > let method_argument () : int =
  >   (obj ())##m ((failwith "boom") 123)
  > let property_argument () : int =
  >   (obj ())#@fn ((failwith "boom") 123)
  > let generic_argument fn : int =
  >   (fn ((failwith "boom") 123) [@u])
  > let receiver () : int =
  >   (((failwith "boom") 123) : < .. > Js.t)##m 1
  > let generic_callee () : int =
  >   (((failwith "boom") 123) 1 [@u])
  > let nested () : int =
  >   (obj ())##m ((obj ())##n ((failwith "boom") 123))
  > EOF
  $ melc -ppx melppx -w +20 -warn-error +20 -c rejected.ml > /dev/null

The caller can still disable warning 20.

  $ melc -ppx melppx -w -20 -warn-error +20 -c rejected.ml > /dev/null
