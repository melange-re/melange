Integer remainder zero must become positive zero, including through float_of_int.
Constant and runtime paths should agree; float remainder must retain negative zero.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.9)' '(using melange 0.1)' > dune-project
  $ cat > dune <<'DUNE'
  > (melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)))
  > DUNE
  $ cat > input.ml <<'ML'
  > let constant = 1. /. float_of_int ((-4) mod 2)
  > let by_two x = 1. /. float_of_int (x mod 2)
  > let by_negative_one x = 1. /. float_of_int (x mod (-1))
  > let variable x y = 1. /. float_of_int (x mod y)
  > let int32 x y = Int32.to_float (Int32.rem x y)
  > let float_rem x y = mod_float x y
  > ML
  $ dune build @melange
  $ cat _build/default/out/input.js
  // Generated by Melange
  'use strict';
  
  const Caml_int32 = require("melange.js/caml_int32.js");
  
  const constant = 1 / 0;
  
  function by_two(x) {
    return 1 / (x % 2);
  }
  
  function by_negative_one(x) {
    return 1 / (x % -1);
  }
  
  function variable(x, y) {
    return 1 / Caml_int32.mod_(x, y);
  }
  
  const int32 = Caml_int32.mod_;
  
  function float_rem(x, y) {
    return x % y;
  }
  
  module.exports = {
    constant,
    by_two,
    by_negative_one,
    variable,
    int32,
    float_rem,
  }
  /* No side effect */
  $ node <<'JS'
  > const m = require('./_build/default/out/input.js');
  > console.log(m.constant, m.by_two(-4), m.by_negative_one(-2147483648), m.variable(-4, 2));
  > console.log(1 / m.int32(-4, 2), 1 / m.float_rem(-4, 2));
  > for (const [x,y] of [[-5,2], [5,-2], [-5,-2]]) console.log(x,y, m.variable(x,y));
