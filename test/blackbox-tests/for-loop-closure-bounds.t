Each closure must capture its own loop iteration, even when bounds need statements.
Both loops should produce 0, 1, 2, and their bounds should run once each.

  $ . ./setup.sh
  $ printf '%s\n' '(lang dune 3.9)' '(using melange 0.1)' > dune-project
  $ cat > dune <<'DUNE'
  > (melange.emit (target out) (libraries melange) (preprocess (pps melange.ppx)))
  > DUNE
  $ cat > input.ml <<'ML'
  > external bound : int -> int = "bound"
  > let ascending () =
  >   let fs = [| (fun () -> -1); (fun () -> -1); (fun () -> -1) |] in
  >   for i = bound 0 to (try bound 2 with _ -> 0) do fs.(i) <- (fun () -> i) done;
  >   Array.map (fun f -> f ()) fs
  > let descending () =
  >   let fs = [| (fun () -> -1); (fun () -> -1); (fun () -> -1) |] in
  >   for i = bound 2 downto (try bound 0 with _ -> 2) do fs.(i) <- (fun () -> i) done;
  >   Array.map (fun f -> f ()) fs
  > ML
  $ dune build @melange
  $ cat _build/default/out/input.js
  // Generated by Melange
  'use strict';
  
  const Caml_array = require("melange.js/caml_array.js");
  const Curry = require("melange.js/curry.js");
  const Stdlib__Array = require("melange/array.js");
  
  function ascending(param) {
    const fs = [
      (function (param) {
        return -1;
      }),
      (function (param) {
        return -1;
      }),
      (function (param) {
        return -1;
      })
    ];
    const i_start = bound(0);
    let tmp;
    try {
      tmp = bound(2);
    }
    catch (exn){
      tmp = 0;
    }
    for (let i = i_start, i_finish = tmp; i <= i_finish; ++i) {
      Caml_array.set(fs, i, (function (param) {
        return i;
      }));
    }
    return Stdlib__Array.map((function (f) {
      return Curry._1(f, undefined);
    }), fs);
  }
  
  function descending(param) {
    const fs = [
      (function (param) {
        return -1;
      }),
      (function (param) {
        return -1;
      }),
      (function (param) {
        return -1;
      })
    ];
    const i_start = bound(2);
    let tmp;
    try {
      tmp = bound(0);
    }
    catch (exn){
      tmp = 2;
    }
    for (let i = i_start, i_finish = tmp; i >= i_finish; --i) {
      Caml_array.set(fs, i, (function (param) {
        return i;
      }));
    }
    return Stdlib__Array.map((function (f) {
      return Curry._1(f, undefined);
    }), fs);
  }
  
  module.exports = {
    ascending,
    descending,
  }
  /* No side effect */
  $ node <<'JS'
  > const m = require('./_build/default/out/input.js');
  > let calls = [];
  > global.bound = x => {calls.push(x); return x};
  > console.log(m.ascending(), calls);
  > calls = [];
  > console.log(m.descending(), calls);
  > JS
  [ 0, 1, 2 ] [ 0, 2 ]
  [ 0, 1, 2 ] [ 2, 0 ]
