An application of a functor from another module to a closed argument is
inlined, so the functions of the argument are called directly

  $ . ./setup.sh
  $ cat > dune-project <<EOF
  > (lang dune 3.13)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<EOF
  > (melange.emit
  >  (target output)
  >  (compile_flags :standard --mel-cross-module-opt)
  >  (emit_stdlib false))
  > EOF

  $ cat > ord.ml <<EOF
  > module type S = sig
  >   val compare : int -> int -> int
  > end
  > module Make (X : S) = struct
  >   let max a b = if X.compare a b >= 0 then a else b
  > end
  > EOF
  $ cat > main.ml <<EOF
  > module M = Ord.Make (struct
  >   let compare x y = x - y
  > end)
  > let m = M.max 1 2
  > EOF

  $ dune build @melange
  $ cat _build/default/output/main.js
  // Generated by Melange
  'use strict';
  
  
  function max(a, b) {
    if ((a - b | 0) >= 0) {
      return a;
    } else {
      return b;
    }
  }
  
  const M = {
    max
  };
  
  const m = max(1, 2);
  
  module.exports = {
    M,
    m,
  }
  /* m Not a pure module */
