A sequence in a for-loop initializer must stay inside the initializer expression.
Each loop should run three times and call tick once before iteration.

  $ . ./setup.sh
  $ cat > run.ml <<'ML'
  > external tick : unit -> unit = "tick"
  > let ascending () =
  >   let n = ref 0 in
  >   for _i = (tick (); 0) to 2 do incr n done;
  >   !n
  > let descending () =
  >   let n = ref 0 in
  >   for _i = (tick (); 2) downto 0 do incr n done;
  >   !n
  > ML
  $ melc -ppx melppx -o run.js run.ml
  $ cat run.js
  // Generated by Melange
  'use strict';
  
  
  function ascending(param) {
    let n = 0;
    for (let _i = tick(), 0; _i <= 2; ++_i) {
      n = n + 1 | 0;
    }
    return n;
  }
  
  function descending(param) {
    let n = 0;
    for (let _i = tick(), 2; _i >= 0; --_i) {
      n = n + 1 | 0;
    }
    return n;
  }
  
  module.exports = {
    ascending,
    descending,
  }
  /* No side effect */
  $ node <<'JS'
  > let calls = 0;
  > global.tick = () => {calls++};
  > try {
  >   const m = require('./run.js');
  >   console.log(m.ascending(), calls);
  >   calls = 0;
  >   console.log(m.descending(), calls);
  > } catch (e) {console.log(e.name)}
  > JS
  SyntaxError
