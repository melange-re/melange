(executable
 (name mel_playground)
 (modes js)
 (libraries
  melangelib
  js_of_ocaml-compiler.runtime
  melange.ppx
  reason-react-ppx
  reason))

(rule
 (targets toolchain.ml)
 (deps toolchain.cppo.ml)
 (action
  (run
   cppo
   -V
   OCAML:%{ocaml_version}
   %{env:CPPO_FLAGS=}
   %{deps}
   -o
   %{targets})))

(rule
 (targets mel_playground.ml)
 (deps mel_playground.cppo.ml)
 (action
  (run
   cppo
   -V
   OCAML:%{ocaml_version}
   %{env:CPPO_FLAGS=}
   %{deps}
   -o
   %{targets})))

(install
 (section bin)
 (package melange-playground)
 (files mel_playground.bc.js melange-cmijs.js))

(rule
 (deps
  (package melange)
  %{bin:ocamlfind}
  %{bin:js_of_ocaml})
 (alias playground-cmijs)
 (target melange-cmijs.js)
 (action
  (run bash %{dep:build_fs.sh} %{target})))
